{"id":35781,"date":"2026-10-07T21:00:00","date_gmt":"2026-10-07T18:00:00","guid":{"rendered":"https:\/\/themadad.com\/?p=35781"},"modified":"2026-10-07T21:00:00","modified_gmt":"2026-10-07T18:00:00","slug":"%d7%a1%d7%a7%d7%a8-%d7%94%d7%9e%d7%93%d7%93-7-%d7%91%d7%90%d7%95%d7%a7%d7%98%d7%95%d7%91%d7%a8-2026","status":"publish","type":"post","link":"https:\/\/themadad.com\/%d7%a1%d7%a7%d7%a8-%d7%94%d7%9e%d7%93%d7%93-7-%d7%91%d7%90%d7%95%d7%a7%d7%98%d7%95%d7%91%d7%a8-2026\/","title":{"rendered":"\u05e1\u05e7\u05e8 \u05d4\u05de\u05d3\u05d3 \u2013 7 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2026"},"content":{"rendered":"<div style=\"margin-top: 0px; margin-bottom: 0px;\" class=\"sharethis-inline-share-buttons\" ><\/div><p><!-- ===== \u05e1\u05e7\u05e8 \u05d4\u05de\u05d3\u05d3 7.10 \u2014 \u05d3\u05d5\u05d7 \u05dc\u05d4\u05d3\u05d1\u05e7\u05d4 \u05d1\u05d5\u05d5\u05e8\u05d3\u05e4\u05e8\u05e1 (Custom HTML block) ===== --><\/p>\n<div class=\"madad-report\" dir=\"rtl\" lang=\"he\">\n<p><!-- ===== MASTHEAD ===== --><\/p>\n<header class=\"mr-head\">\n<h1 class=\"mr-title\">\u05e1\u05e7\u05e8 \u05d4\u05de\u05d3\u05d3<\/h1>\n<p class=\"mr-sub\">\u05ea\u05de\u05d5\u05e0\u05ea \u05de\u05e6\u05d1 \u05e4\u05d5\u05dc\u05d9\u05d8\u05d9\u05ea \u00b7 7 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2026<\/p>\n<div class=\"mr-meta\">\n    <span><b>1,263<\/b> \u05de\u05e9\u05d9\u05d1\u05d9\u05dd<\/span><br \/>\n    <span>\u05d8\u05e2\u05d5\u05ea \u05d3\u05d2\u05d9\u05de\u05d4 \u00b12.8% (\u05d1\u05e8\u05de\u05ea \u05d1\u05d9\u05d8\u05d7\u05d5\u05df 95%)<\/span>\n  <\/div>\n<\/header>\n<p><!-- ===== \u05e7\u05e8\u05d3\u05d9\u05d8\u05d9\u05dd ===== --><\/p>\n<div class=\"mr-credits\">\n  <b>\u05e1\u05e7\u05e8 \u05d4\u05de\u05d3\u05d3<\/b> \u2014 \u05e9\u05de\u05d5\u05d0\u05dc \u05e8\u05d5\u05d6\u05e0\u05e8, \u05e0\u05d7 \u05e1\u05dc\u05e4\u05e7\u05d5\u05d1 \u00b7 \u05d1\u05e9\u05d9\u05ea\u05d5\u05e3 <b>\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05de\u05d3\u05d2\u05dd<\/b> (\u05d3\u05f4\u05e8 \u05d0\u05e8\u05d9\u05d0\u05dc \u05d0\u05d9\u05d9\u05dc\u05d5\u05df),<br \/>\n  <b>\u05d0\u05e1\u05e7\u05e8\u05d9\u05d0<\/b> (\u05d3\u05d5\u05d3\u05d9 \u05d3\u05e8\u05d5\u05e8) \u05d5<b>\u05e1\u05d8\u05d0\u05d8\u05e0\u05d8<\/b> (\u05d9\u05d5\u05e1\u05e3 \u05de\u05e7\u05dc\u05d3\u05d4). \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e0\u05d5\u05e1\u05e4\u05d9\u05dd: Hive.<br \/>\n  \u05d9\u05d9\u05e2\u05d5\u05e5 \u05e1\u05d8\u05d8\u05d9\u05e1\u05d8\u05d9: \u05e4\u05e8\u05d5\u05e4\u05f3 \u05d3\u05d5\u05d3 \u05e9\u05d8\u05d9\u05d9\u05e0\u05d1\u05e8\u05d2.<br \/>\n  \u05d4\u05e1\u05e7\u05e8 \u05e0\u05e2\u05e8\u05da \u05d1\u05e7\u05e8\u05d1 <b>1,263<\/b> \u05de\u05e9\u05d9\u05d1\u05d9\u05dd, \u05e2\u05dd \u05d8\u05e2\u05d5\u05ea \u05d3\u05d2\u05d9\u05de\u05d4 \u05de\u05de\u05d5\u05e6\u05e2\u05ea \u05d1\u05e8\u05de\u05d4 \u05d4\u05d0\u05e8\u05e6\u05d9\u05ea \u05e9\u05dc <b>\u00b12.8<\/b> \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05d0\u05d7\u05d5\u05d6. \u05de\u05d5\u05e2\u05d3 \u05d4\u05d0\u05d9\u05e1\u05d5\u05e3: 6 \u05d1\u05d0\u05d5\u05e7\u05d8\u05d5\u05d1\u05e8 2026.\n<\/div>\n<p><!-- ===== \u05de\u05e0\u05d3\u05d8\u05d9\u05dd ===== --><\/p>\n<section class=\"mr-sec\">\n<h2 class=\"mr-h2\">\u05de\u05e0\u05d3\u05d8\u05d9\u05dd<\/h2>\n<p class=\"mr-note\">\u05ea\u05d7\u05d6\u05d9\u05ea \u05d4\u05de\u05e0\u05d3\u05d8\u05d9\u05dd \u05d4\u05e9\u05d1\u05d5\u05e2 \u05d5\u05d4\u05e9\u05d9\u05e0\u05d5\u05d9 \u05de\u05d5\u05dc \u05d4\u05e9\u05d1\u05d5\u05e2 \u05e9\u05e2\u05d1\u05e8 (\u05de\u05ea\u05d5\u05da 120). \u05d9\u05e9\u05e8 (\u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8) \u05d9\u05d5\u05e8\u05d3 \u05d1-1 \u05dc-20; \u05dc\u05d9\u05db\u05d5\u05d3 \u05e2\u05d5\u05dc\u05d4 \u05d1-1 \u05dc-20 \u2014 \u05e9\u05e0\u05d9\u05d4\u05dd \u05e7\u05e9\u05d5\u05e8\u05d9\u05dd \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05df. \u05d1\u05d9\u05d7\u05d3 (\u05d1\u05e0\u05d8) \u05e2\u05d5\u05dc\u05d4 \u05d1-1 \u05dc-12; \u05d4\u05d3\u05de\u05d5\u05e7\u05e8\u05d8\u05d9\u05dd \u05d9\u05d5\u05e8\u05d3\u05d9\u05dd \u05d1-1 \u05dc-10. \u05d9\u05e9\u05e8\u05d0\u05dc \u05d1\u05d9\u05ea\u05e0\u05d5 \u05d9\u05d5\u05e8\u05d3\u05ea \u05d1-1 \u05dc-8; \u05e8\u05e2\u05f4\u05de \u05e2\u05d5\u05dc\u05d4 \u05d1-1 \u05dc-6. \u05e2\u05de\u05da \u05d9\u05e9\u05e8\u05d0\u05dc (\u05d5\u05d9\u05e0\u05d8\u05e8) \u05e9\u05d5\u05de\u05e8\u05ea \u05e2\u05dc 5 \u05de\u05e0\u05d3\u05d8\u05d9\u05dd \u05de\u05e2\u05dc \u05d0\u05d7\u05d5\u05d6 \u05d4\u05d7\u05e1\u05d9\u05de\u05d4; \u05d4\u05de\u05d9\u05dc\u05d5\u05d0\u05d9\u05de\u05e0\u05d9\u05e7\u05d9\u05dd-\u05d4\u05db\u05dc\u05db\u05dc\u05d9\u05ea (\u05d4\u05e0\u05d3\u05dc-\u05d6\u05dc\u05d9\u05db\u05d4) \u05e0\u05e9\u05de\u05d8\u05ea \u05de\u05ea\u05d7\u05ea\u05d9\u05d5.<\/p>\n<div class=\"mr-seats\">\n<div class=\"mr-seatrow\">\n<div class=\"mr-pname\">\u05d9\u05e9\u05e8 (\u05d0\u05d9\u05d6\u05e0\u05e7\u05d5\u05d8)<\/div>\n<div class=\"mr-pnum\"><span class=\"n\">20<\/span><span class=\"mr-chg down\">\u25bc1<\/span><\/div>\n<div class=\"mr-track\">\n<div class=\"mr-fill lead\" style=\"width:100%\"><\/div>\n<\/div><\/div>\n<div class=\"mr-seatrow\">\n<div class=\"mr-pname\">\u05dc\u05d9\u05db\u05d5\u05d3<\/div>\n<div class=\"mr-pnum\"><span class=\"n\">20<\/span><span class=\"mr-chg up\">\u25b21<\/span><\/div>\n<div class=\"mr-track\">\n<div class=\"mr-fill lead\" style=\"width:100%\"><\/div>\n<\/div><\/div>\n<div class=\"mr-seatrow\">\n<div class=\"mr-pname\">\u05d1\u05d9\u05d7\u05d3 (\u05d1\u05e0\u05d8)<\/div>\n<div class=\"mr-pnum\"><span class=\"n\">12<\/span><span class=\"mr-chg up\">\u25b21<\/span><\/div>\n<div class=\"mr-track\">\n<div class=\"mr-fill\" style=\"width:60%\"><\/div>\n<\/div><\/div>\n<div class=\"mr-seatrow\">\n<div class=\"mr-pname\">\u05d4\u05d3\u05de\u05d5\u05e7\u05e8\u05d8\u05d9\u05dd<\/div>\n<div class=\"mr-pnum\"><span class=\"n\">10<\/span><span class=\"mr-chg down\">\u25bc1<\/span><\/div>\n<div class=\"mr-track\">\n<div class=\"mr-fill\" style=\"width:50%\"><\/div>\n<\/div><\/div>