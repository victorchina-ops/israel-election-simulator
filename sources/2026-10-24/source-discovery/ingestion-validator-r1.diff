+def expected_named_bound(source):
+    # Preserve source-published censoring without converting it to an exact share.
+    bound = source.get("publishedBounds")
+    if bound is None and source.get("pctUpperBound") is not None:
+        bound = {"max": source["pctUpperBound"], "maxExclusive": source.get("maxExclusive", False)}
+    if bound is None:
+        return None
+    assert source.get("pct") is None, "A named censored share must not become an exact percentage"
+    assert isinstance(bound, dict) and bound.get("maxExclusive") is True
+    upper = bound.get("max")
+    assert isinstance(upper, (int, float)) and not isinstance(upper, bool) and 0 < upper <= 100
+    assert bound.get("min", 0) == 0, "Unsupported named lower-bound semantics require a separate review"
+    return "פחות מ־" + str(upper) + "%"
+
+
+def compatibility_gate():
+    assert sha(ORIGINAL_VALIDATOR) == ORIGINAL_VALIDATOR_SHA256, "Original validator must remain unchanged"
+    failed = COMPATIBILITY_DIR / "original-validator-reproduced-failure.stderr.txt"
+    assert sha(failed) == ORIGINAL_FAILURE_STDERR_SHA256
+    reproduction = read(COMPATIBILITY_DIR / "original-validator-failure-reproduction.json")
+    assert reproduction["status"] == "ORIGINAL_FAILURE_REPRODUCED_BEFORE_FIX" and reproduction["exitCode"] == 1
+    assert reproduction["originalValidatorSha256"] == ORIGINAL_VALIDATOR_SHA256
+    assert reproduction["stderrSha256"] == ORIGINAL_FAILURE_STDERR_SHA256
+    peer_path = COMPATIBILITY_DIR / "peer-source-review.json"
+    peer = read(peer_path)
+    assert peer["status"] == "PASS"
+    assert peer["originalValidatorSha256"] == ORIGINAL_VALIDATOR_SHA256
+    assert peer["effectiveValidatorSha256"] == sha(Path(__file__))
+    assert peer["sourcePlanSha256"] == sha(ART / "source-plan.json")
+    assert peer["originalFailureStderrSha256"] == ORIGINAL_FAILURE_STDERR_SHA256
+    return {"originalValidatorContractSha256": ORIGINAL_VALIDATOR_SHA256,
+            "effectiveValidatorPath": "scripts/validate-ingestion-2026-10-24-r1.py",
+            "effectiveValidatorSha256": sha(Path(__file__)),
+            "peerSourceReviewPath": peer_path.relative_to(ROOT).as_posix(),
+            "peerSourceReviewSha256": sha(peer_path),
+            "originalFailureStderrPath": failed.relative_to(ROOT).as_posix(),
+            "originalFailureStderrSha256": ORIGINAL_FAILURE_STDERR_SHA256,
+            "scope": "Named exact percentages and source-published exclusive upper bounds remain separate; no source, canonical, model or statistical changes."}
+
+
 def main():
